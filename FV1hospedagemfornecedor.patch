+
+        <!-- PREÇO / QUARTOS -->
+        <div class="ch-field ch-field--row">
+          <div class="ch-field">
+            <label>Valor (R$)</label>
+            <input type="number" placeholder="0,00" [(ngModel)]="preco" />
+          </div>
+          <div class="ch-field">
+            <label>Quartos</label>
+            <input type="number" placeholder="Opcional" [(ngModel)]="quartos" />
+          </div>
+        </div>
+
+        <!-- RUA -->
+        <div class="ch-field">
+          <label>Rua</label>
+          <input type="text" placeholder="Opcional" [(ngModel)]="rua" />
+        </div>
+
+        <!-- BAIRRO -->
+        <div class="ch-field">
+          <label>Bairro</label>
+          <input type="text" placeholder="Opcional" [(ngModel)]="bairro" />
+        </div>
+
+        <!-- CIDADE / ESTADO -->
+        <div class="ch-field ch-field--row">
+          <div class="ch-field">
+            <label>Cidade</label>
+            <input type="text" placeholder="Opcional" [(ngModel)]="cidade" />
+          </div>
+          <div class="ch-field">
+            <label>Estado</label>
+            <input type="text" placeholder="Opcional" [(ngModel)]="estado" />
+          </div>
+        </div>
+
+        <!-- DESCRIÇÃO -->
+        <div class="ch-field">
+          <label>Descrição</label>
+          <textarea rows="4" placeholder="Detalhes da hospedagem" [(ngModel)]="descricao"></textarea>
+        </div>
+
+        <!-- ATIVA -->
+        <label class="ch-toggle">
