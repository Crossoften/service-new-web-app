+  &__toggle {
+    background: none;
+    border: none;
+    cursor: pointer;
+    color: var(--color-gray-400);
+    display: flex;
+    align-items: center;
+    padding: 0;
+  }
+}
+
+.rec-erro {
+  font-size: 12px;
+  color: #dc2626;
+  margin-top: -8px;
+}
+
+.rec-link {
+  background: none;
+  border: none;
+  cursor: pointer;
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--color-primary);
+  text-align: left;
+  padding: 0;
+}
+
+.rec-actions {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 24px;
+}
+
+.rec-btn {
+  width: 100%;
+  padding: 16px;
+  border-radius: 50px;
+  font-size: 14px;
+  font-weight: 700;
+  letter-spacing: 0.5px;
+  cursor: pointer;
+  transition: opacity 0.2s;
+
+  &:active {
+    opacity: 0.85;
+  }
+
+  &:disabled {
+    opacity: 0.6;
+    cursor: default;
+  }
+
+  &--primary {
+    background: var(--color-primary);
+    color: var(--color-white);
+    border: none;
+  }
+
+  &--outline {
+    background: transparent;
+    color: var(--color-primary);
+    border: 2px solid var(--color-primary);
+  }
+}
