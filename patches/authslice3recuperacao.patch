+
+    svg {
+      color: var(--color-gray-400);
+      flex-shrink: 0;
+    }
+
+    input {
+      flex: 1;
+      border: none;
+      background: none;
+      outline: none;
+      font-size: 14px;
+      color: var(--color-text);
+
+      &::placeholder {
+        color: var(--color-gray-400);
+      }
+    }
+  }
