+        <!-- VALOR -->
+        <div class="ca-field">
+          <label>Valor (R$)</label>
+          <input type="number" placeholder="0,00" [(ngModel)]="preco" />
+        </div>
+
+        <!-- DESCRIÇÃO -->
+        <div class="ca-field">
+          <label>Descrição</label>
+          <textarea rows="4" placeholder="Detalhes do item" [(ngModel)]="descricao"></textarea>
+        </div>
