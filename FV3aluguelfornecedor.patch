+            </div>
+
+            <div class="laf-card__info">
+              <span class="laf-card__nome">{{ p.name }}</span>
+              <span class="laf-card__categoria">● {{ p.category.name }}</span>
+              <span class="laf-card__tipo">{{ tipoLabel(p.transactionType) }}</span>
+              <span class="laf-card__preco">{{ formatarPreco(p.price) }}</span>
+              <div class="laf-card__stats">
+                <span class="laf-card__stat laf-card__stat--like">👍 {{ p.positiveReviews }}</span>
+                <span class="laf-card__stat laf-card__stat--dislike">👎 {{ p.negativeReviews }}</span>
+              </div>
+            </div>
+
+          </div>
+        }
+
+        @if (itens.length === 0) {
+          <div class="laf-vazio">
+            <p>Nenhum item de aluguel {{ tabAtiva === 'ativos' ? 'ativo' : 'inativo' }} encontrado.</p>
+          </div>
+        }
+      </div>
+    }
+  </div>
+
+  <!-- FAB -->
+  <button class="laf-fab" (click)="adicionar()" aria-label="Cadastrar item de aluguel">
+    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5">
+      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
+    </svg>
+  </button>
+
+</div>
