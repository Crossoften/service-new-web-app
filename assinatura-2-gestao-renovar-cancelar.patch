+<div class="assins-container">
+
+  <div class="assins-header">
+    <button class="assins-header__voltar" (click)="voltar()" aria-label="Voltar">
+      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
+        <polyline points="15 18 9 12 15 6"/>
+      </svg>
+    </button>
+    <span class="assins-header__titulo">MINHAS ASSINATURAS</span>
+    <div style="width: 30px"></div>
+  </div>
+
+  <div class="assins-content">
+
+    @if (carregando) {
+      <p class="assins-msg">Carregando…</p>
+    } @else {
+
+      @if (erro) { <span class="assins-erro">{{ erro }}</span> }
+
+      @if (assinaturas.length === 0) {
+        <p class="assins-msg">Você ainda não assina nenhuma categoria.</p>
+      } @else {
+        <div class="assins-lista">
