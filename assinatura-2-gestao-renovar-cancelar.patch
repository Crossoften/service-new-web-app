+                <span class="assins-card__plano">{{ vm.sub.planName }}</span>
+              </div>
+              <span class="assins-card__status" [class.assins-card__status--destaque]="vm.destaque">
+                {{ vm.statusTexto }}
+              </span>
+
+              <div class="assins-card__acoes">
+                @if (vm.acao === 'renovar') {
+                  <button class="assins-btn assins-btn--primaria"
+                    [disabled]="processandoId !== null"
+                    (click)="renovar(vm)">
+                    {{ processandoId === vm.sub.id ? 'Processando…' : 'Renovar' }}
+                  </button>
+                }
+                @if (vm.acao === 'reativar') {
+                  <button class="assins-btn assins-btn--primaria"
+                    [disabled]="processandoId !== null"
+                    (click)="reativar(vm)">
+                    {{ processandoId === vm.sub.id ? 'Processando…' : 'Reativar' }}
+                  </button>
+                }
+                @if (vm.podeCancelar) {
+                  <button class="assins-btn assins-btn--secundaria"
+                    [disabled]="processandoId !== null"
+                    (click)="cancelar(vm)">
+                    Cancelar
+                  </button>
+                }
+              </div>
+            </div>
+          }
+        </div>
+      }
+
+      @if (temCategoriaDisponivel) {
+        <button class="assins-nova" (click)="assinarNova()">+ Assinar nova categoria</button>
+      }
+
+    }
